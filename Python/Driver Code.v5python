{"mode":"Text","hardwareTarget":"brain","textContent":"from vex import *\n\nDEADBAND = 5          \nLIFT_SPEED = 100      # (% power)\nROTATE_SPEED = 30     # (% power)\nDRIVE_USE_VOLTS = True\nDRIVE_MAX_VOLTS = 12.0  \nSERVO_ZERO = -100     # (in degrees)  \nSERVO_TURNED = 100     # (in degrees)\n\nbrain = Brain()\ncontroller_1 = Controller(PRIMARY)\n\nleft_drive = Motor55(Ports.PORT2, False)\nright_drive = Motor55(Ports.PORT4, True)\n\ntower_lift = Motor55(Ports.PORT8, False)     \ntower_rotate = Motor55(Ports.PORT12, False)  \n\nexpander = Triport(Ports.PORT10)\nservo_1 = Servo(expander.d)\n\ndef apply_deadband(value):\n    if abs(value) < DEADBAND:\n        return 0\n    return value\n\n\ndef clamp(value):\n    return max(-100, min(100, value))\n\n\ndef run(motor, percent):\n    if percent >= 0:\n        motor.set_velocity(percent, PERCENT)\n        motor.spin(FORWARD)\n    else:\n        motor.set_velocity(-percent, PERCENT)\n        motor.spin(REVERSE)\n\n\ndef run_volts(motor, percent):\n    volts = abs(percent) / 100.0 * DRIVE_MAX_VOLTS\n    if percent >= 0:\n        motor.spin(FORWARD, volts, VOLT)\n    else:\n        motor.spin(REVERSE, volts, VOLT)\n\n\ndef drive(motor, percent):\n    if DRIVE_USE_VOLTS:\n        run_volts(motor, percent)\n    else:\n        run(motor, percent)\n\nARCADE = \"ARCADE\"\nTANK = \"TANK\"\ndrive_mode = ARCADE\nservo_target = SERVO_ZERO\npresses_a = 0\npresses_x = 0\npresses_b = 0\n\ndef show_status():\n    brain.screen.clear_screen()\n    brain.screen.set_cursor(1, 1)\n    brain.screen.print(\"Drive: \" + drive_mode)\n    brain.screen.set_cursor(2, 1)\n    brain.screen.print(\"Servo target: \" + str(servo_target))\n    brain.screen.set_cursor(3, 1)\n    brain.screen.print(\"Presses  A:\" + str(presses_a)\n                       + \"  X:\" + str(presses_x)\n                       + \"  B:\" + str(presses_b))\n    brain.screen.set_cursor(4, 1)\n    brain.screen.print(\"Motor mode: \" + (\"VOLTS\" if DRIVE_USE_VOLTS else \"PERCENT\")\n                       + \"  MC55 max: \" + max_voltage_text)\n    brain.screen.set_cursor(5, 1)\n    brain.screen.print(\"Battery: \" + battery_text)\n\n    controller_1.screen.clear_screen()\n    controller_1.screen.set_cursor(1, 1)\n    controller_1.screen.print(\"Drive: \" + drive_mode)\n    controller_1.screen.set_cursor(2, 1)\n    controller_1.screen.print(\"Servo: \" + str(servo_target))\n\n\ndef set_servo(position):\n    global servo_target\n    servo_target = position\n    servo_1.set_position(position, DEGREES)\n\ntry:\n    max_voltage_text = str(left_drive.get_max_voltage()) + \" mV\"\nexcept Exception as e:\n    max_voltage_text = \"n/a\"\ntry:\n    battery_text = str(brain.battery.capacity()) + \"%\"\nexcept Exception as e:\n    battery_text = \"n/a\"\n\nset_servo(SERVO_ZERO)\nshow_status()\n\nprev_a = False\nprev_x = False\nprev_b = False\n\nwhile True:\n    a_now = controller_1.buttonA.pressing()\n    x_now = controller_1.buttonX.pressing()\n    b_now = controller_1.buttonB.pressing()\n\n    if a_now and not prev_a:\n        presses_a += 1\n        drive_mode = TANK if drive_mode == ARCADE else ARCADE\n        show_status()\n        controller_1.rumble(\".\")  # haptic feedback :D\n\n    if x_now and not prev_x:\n        presses_x += 1\n        set_servo(SERVO_TURNED)\n        show_status()\n\n    if b_now and not prev_b:\n        presses_b += 1\n        set_servo(SERVO_ZERO)\n        show_status()\n\n    prev_a = a_now\n    prev_x = x_now\n    prev_b = b_now\n\n    if drive_mode == ARCADE:\n        forward = apply_deadband(controller_1.axis3.position()) \n        turn = apply_deadband(controller_1.axis4.position())  \n        left_power = clamp(forward - turn) \n        right_power = clamp(forward + turn)\n    else:\n        left_power = apply_deadband(controller_1.axis2.position())   \n        right_power = apply_deadband(controller_1.axis3.position())  \n\n    drive(left_drive, left_power)\n    drive(right_drive, right_power)\n\n    if controller_1.buttonR1.pressing():\n        drive(tower_lift, LIFT_SPEED)\n    elif controller_1.buttonR2.pressing():\n        drive(tower_lift, -LIFT_SPEED)\n    else:\n        drive(tower_lift, 0)\n\n    if controller_1.buttonL1.pressing():\n        run(tower_rotate, ROTATE_SPEED)\n    elif controller_1.buttonL2.pressing():\n        run(tower_rotate, -ROTATE_SPEED)\n    else:\n        run(tower_rotate, 0)\n\n    wait(20, MSEC)","textLanguage":"python","robotConfig":[],"slot":0,"platform":"V5","sdkVersion":"20240802.15.00.00","appVersion":"4.68.0","minVersion":"4.60.0","fileFormat":"2.0.0","targetBrainGen":"First","v5Sounds":[{"name":"game over","url":"static/sounds/mixkit-arcade-retro-game-over-213.wav"}],"v5SoundsEnabled":false,"aiVisionSettings":{"colors":[],"codes":[],"tags":true,"AIObjects":true,"AIObjectModel":[],"aiModelDropDownValue":null},"target":"Physical"}